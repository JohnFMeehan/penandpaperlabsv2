# Copy to .env and fill in once the Shopify store exists (see README.md).
# Both must be PUBLIC_-prefixed: the cart runs client-side, and the Storefront
# API token is designed to be public (it's scoped to read-only + cart operations).
PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
