---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { categoryIcon, readTime, byDateDesc, formatDate } from '../../utils/journal';

const entries = (await getCollection('journal')).sort(byDateDesc);
---
<Layout title="Pen &amp; Paper Labs — Journal" active="Journal">
<style>
  .page-head {
    display: grid; grid-template-columns: 1fr auto;
    align-items: end; padding: clamp(24px,5vw,56px) var(--gut) 22px;
    border-bottom: 1px solid var(--line);
  }
  .page-head h1 { font-size: clamp(46px,11vw,140px); }
  .page-head sup { font-size: 0.22em; vertical-align: super; color: var(--grey); }
  .page-head .count { font-family:"SF Mono",Menlo,monospace; font-size:11px; color:var(--grey); text-transform:uppercase; letter-spacing:0.08em; text-align:right; }

  .filters {
    display: flex; gap: 0; border-bottom: 1px solid var(--line);
    font-family:"SF Mono",Menlo,monospace; font-size:11px; text-transform:uppercase; letter-spacing:0.06em;
    overflow-x: auto;
  }
  .filters button {
    border: none; border-right: 1px solid var(--faint); background: var(--paper);
    padding: 12px 18px; cursor: pointer; white-space: nowrap; color: var(--grey);
    font-family: inherit; font-size: inherit; text-transform: inherit; letter-spacing: inherit;
  }
  .filters button.on { background: var(--ink); color: var(--paper); }
  .filters button:hover { background: var(--ink); color: var(--paper); }
  .filters .spacer { flex: 1; border-right: none; }

  .index-row {
    display: grid; grid-template-columns: 70px 110px 1fr 150px 90px;
    align-items: baseline; gap: 18px;
    padding: 14px var(--gut); border-bottom: 1px solid var(--faint);
    font-size: 15px;
  }
  .index-row:hover { background: var(--ink); color: var(--paper); }
  .index-row:hover .mut, .index-row:hover .tag { color: var(--paper); border-color: var(--paper); }
  .index-row .mut { font-family:"SF Mono",Menlo,monospace; font-size:11px; color:var(--grey); }
  .index-row .ttl { font-weight: 500; }
  .index-row .rt { text-align: right; }
  .index-header {
    display: grid; grid-template-columns: 70px 110px 1fr 150px 90px; gap: 18px;
    padding: 9px var(--gut); border-bottom: 1px solid var(--line);
    font-family:"SF Mono",Menlo,monospace; font-size:10px; text-transform:uppercase;
    letter-spacing:0.1em; color:var(--grey);
  }
  .index-header .rt { text-align:right; }

  @media (max-width: 820px){
    .index-header { display:none; }
    .index-row { grid-template-columns: 50px 1fr; }
    .index-row .cat, .index-row .read { display:none; }
  }
</style>

<main>
  <div class="page-head">
    <h1 class="display">Journal<sup>[{entries.length}]</sup></h1>
    <div class="count">Notes on making<br>things, in public.</div>
  </div>

  <div class="filters" id="journalFilters">
    <button class="on" data-filter="all">All</button>
    <button data-filter="Print"><svg class="ico"><use href="#i-print"/></svg>Print</button>
    <button data-filter="Paper"><svg class="ico"><use href="#i-note"/></svg>Paper</button>
    <button data-filter="Electronics"><svg class="ico"><use href="#i-hw"/></svg>Electronics</button>
    <button data-filter="Software"><svg class="ico"><use href="#i-sw"/></svg>Software</button>
    <button data-filter="Process"><svg class="ico"><use href="#i-process"/></svg>Process</button>
    <button data-filter="Shop notes"><svg class="ico"><use href="#i-tag"/></svg>Shop notes</button>
    <span class="spacer"></span>
    <button id="journalSort" data-sort="newest">↓ Newest</button>
  </div>

  <div class="index-header">
    <span>№</span><span>Cat</span><span>Title</span><span class="rt">Date</span><span class="rt">Read</span>
  </div>

  <div id="journalList">
    {entries.map((entry, i) => (
      <a href={`/journal/${entry.data.slug}`} data-category={entry.data.category} data-date={entry.data.date.valueOf()} data-order={i}>
        <div class="index-row">
          <span class="mut">{String(i + 1).padStart(3, '0')}</span>
          <span class="tag"><svg class="ico"><use href={`#${categoryIcon[entry.data.category]}`}/></svg>{entry.data.category}</span>
          <span class="ttl">{entry.data.title}</span>
          <span class="mut rt cat">{formatDate(entry.data.date)}</span>
          <span class="mut rt read">{readTime(entry.body ?? '')}</span>
        </div>
      </a>
    ))}
  </div>
</main>

<script>
  const filtersEl = document.getElementById('journalFilters')!;
  const listEl = document.getElementById('journalList')!;
  const sortBtn = document.getElementById('journalSort') as HTMLButtonElement;
  const rows = Array.from(listEl.querySelectorAll<HTMLAnchorElement>('a'));
  let activeFilter = 'all';

  function applyFilter() {
    for (const row of rows) {
      const matches = activeFilter === 'all' || row.dataset.category === activeFilter;
      row.style.display = matches ? '' : 'none';
    }
  }

  function applySort(mode: string) {
    const sorted = [...rows].sort((a, b) => {
      const diff = Number(a.dataset.date) - Number(b.dataset.date);
      return mode === 'oldest' ? diff : -diff;
    });
    for (const row of sorted) listEl.appendChild(row);
  }

  filtersEl.querySelectorAll<HTMLButtonElement>('button[data-filter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      activeFilter = btn.dataset.filter!;
      filtersEl.querySelectorAll('button[data-filter]').forEach((b) => b.classList.toggle('on', b === btn));
      applyFilter();
    });
  });

  sortBtn.addEventListener('click', () => {
    const next = sortBtn.dataset.sort === 'newest' ? 'oldest' : 'newest';
    sortBtn.dataset.sort = next;
    sortBtn.textContent = next === 'newest' ? '↓ Newest' : '↑ Oldest';
    applySort(next);
  });
</script>
</Layout>
